NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Role ứng dụng (không phải owner) -> RLS có hiệu lực
DATABASE_URL=postgres://htm_app:htm_app_dev@localhost:5432/htm
# Role owner, chỉ dùng cho migrate/seed
MIGRATION_DATABASE_URL=postgres://htm:htm_dev@localhost:5432/htm
DB_POOL_MAX=10
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# Mật khẩu ban đầu cho tài khoản seed (bắt buộc khi chạy db:seed)
SEED_PASSWORD=
